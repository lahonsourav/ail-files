{
  "name": "ail-files",
  "version": "0.1.2",
  "description": "Generate PowerPoint, PDF, Word and Excel files from JSON. Add your own slide layouts and themes.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./browser": { "types": "./dist/browser.d.ts", "import": "./dist/browser.js", "default": "./dist/browser.js" },
    "./edit": { "types": "./dist/edit.d.ts", "import": "./dist/edit.js", "default": "./dist/edit.js" },
    "./editor": { "types": "./dist/editor.d.ts", "import": "./dist/editor.js", "default": "./dist/editor.js" },
    "./editor-tokens.css": "./styles/editor-tokens.css"
  },
  "bin": { "ail-files": "./dist/cli.js" },
  "files": ["dist", "themes", "examples", "styles", "LICENSE", "NOTICE", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "katex": "^0.19.0",
    "playwright-core": "^1.62.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.12",
    "vite": "^8.3.5",
    "typescript": "^7",
    "vitest": "^5.0.5"
  },
  "keywords": ["pptx", "powerpoint", "pdf", "docx", "xlsx", "slides", "templates", "ai"],
  "repository": { "type": "git", "url": "git+https://github.com/lahonsourav/ail-files.git" }
}
